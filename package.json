{
  "name": "bloom-nail-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply bloom-nail-studio-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply bloom-nail-studio-db --remote",
    "db:seed:local": "node scripts/seed.mjs && wrangler d1 execute bloom-nail-studio-db --local --file=./scripts/seed.sql",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.15",
    "lucide-react": "^1.69.0",
    "next": "16.4.5",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.158.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@swc/core@1.16.22": true,
    "workerd@1.20261104.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.18.20": true,
    "esbuild@0.28.2": true
  }
}
